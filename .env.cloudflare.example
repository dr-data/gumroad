# Cloudflare environment configuration for Gumroad
# Copy this to .env.cloudflare for local development

# Cloudflare-specific variables
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here
CLOUDFLARE_ZONE_ID=your_zone_id_here

# Origin server configuration for proxying
ORIGIN_SERVER_URL=https://your-origin-server.com
ORIGIN_SERVER_API_KEY=your_origin_api_key

# Cloudflare services configuration
CLOUDFLARE_KV_NAMESPACE_ID=your_kv_namespace_id
CLOUDFLARE_R2_BUCKET_NAME=gumroad-assets
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id

# Asset hosting
ASSET_HOST=https://gumroad.pages.dev
CDN_URL=https://gumroad.pages.dev/assets

# Environment settings
RAILS_ENV=production
RACK_ENV=production
NODE_ENV=production

# Security settings
FORCE_SSL=true
SSL_REDIRECT=true

# Caching settings
ENABLE_CLOUDFLARE_CACHE=true
CACHE_TTL=300
STATIC_CACHE_TTL=31536000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Monitoring and debugging
CLOUDFLARE_DEBUG=false
LOG_LEVEL=info

# Database configuration (if using Cloudflare services)
# Note: For a full Rails migration, you might need external database services
DATABASE_URL=postgresql://user:password@your-postgres-host:5432/gumroad_production
REDIS_URL=redis://your-redis-host:6379/0
ELASTICSEARCH_URL=https://your-elasticsearch-host:9200
MONGODB_URL=mongodb://your-mongodb-host:27017/gumroad_production

# External service integrations
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
S3_BUCKET=your-s3-bucket

# Email service
RESEND_API_KEY=your_resend_api_key
SENDGRID_API_KEY=your_sendgrid_api_key

# Payment services
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Analytics and monitoring
BUGSNAG_API_KEY=your_bugsnag_api_key
GOOGLE_ANALYTICS_ID=your_ga_id

# Feature flags
FLIPPER_REDIS_URL=${REDIS_URL}

# Session and authentication
SECRET_KEY_BASE=your_secret_key_base
DEVISE_SECRET_KEY=your_devise_secret_key

# Content Security Policy
CSP_REPORT_URI=https://your-csp-report-endpoint.com